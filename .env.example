# Set JWT_SECRET_KEY to a random value of at least 32 characters before starting services.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

AUTH_SERVICE_URL=http://127.0.0.1:8001
STUDENT_SERVICE_URL=http://127.0.0.1:8002
COURSE_SERVICE_URL=http://127.0.0.1:8003
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional, service-specific database locations (SQLite defaults are local .db files).
# AUTH_DATABASE_URL=sqlite:///./auth.db
# STUDENT_DATABASE_URL=sqlite:///./students.db
# COURSE_DATABASE_URL=sqlite:///./courses.db
